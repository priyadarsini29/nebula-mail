# ==============================================================================
# Stitch AI Mail Client - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.local for development.
# Do NOT commit .env or .env.local to version control!

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Frontend Browser Safe)
# ------------------------------------------------------------------------------
# Accessible in the browser client (prefixed with VITE_)
# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings -> API -> anon public key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Backend / Server-Side ONLY)
# ------------------------------------------------------------------------------
# Project Settings -> API -> service_role secret key
# NEVER expose this key in the client, bundle, or frontend code!
# Used only by server functions, Pub/Sub webhook handlers, and background workers.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-here

# Database direct connection string (optional, for migrations or ORMs)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. GMAIL API & OAUTH CONFIGURATION (Backend / Server-Side ONLY)
# ------------------------------------------------------------------------------
# Backend Server Configuration
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Google Cloud Console -> APIs & Services -> Credentials
# Required for Gmail OAuth token exchange and refresh. Server-side only!
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
# For local development with Vite dev server proxying /api to backend:
GMAIL_REDIRECT_URI=http://localhost:5173/api/auth/callback/google
# (Or direct backend URL: http://localhost:3001/api/auth/callback/google)

# Google Cloud Pub/Sub Topic for Gmail push notifications
# e.g. projects/your-gcp-project-id/topics/gmail-notifications
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-gcp-project-id/subscriptions/gmail-sub

# Encryption key for securing stored OAuth tokens at rest in database (32 bytes hex)
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-tokens-at-rest

# ------------------------------------------------------------------------------
# 4. AI COPILOT ACTION LAYER CONFIGURATION
# ------------------------------------------------------------------------------
# LLM Provider API Key (Gemini, Claude, or OpenAI)
AI_API_KEY=your-ai-api-key-here
AI_MODEL_NAME=gemini-2.5-flash

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development
